* text=auto
*.py text eol=lf
*.sh text eol=lf
*.rc text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Retain upstream AOSP header whitespace rather than silently rewriting it.
native/include/hardware/*.h whitespace=-blank-at-eol
native/include/cutils/*.h whitespace=-blank-at-eol
